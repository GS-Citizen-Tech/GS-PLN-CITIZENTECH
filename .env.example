# ---------- LLM (qualquer API compatível com OpenAI) ----------
# Groq (padrão do projeto, free tier):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=coloque_sua_chave_aqui
LLM_MODELO=openai/gpt-oss-120b   # comparação: openai/gpt-oss-20b
# Ollama local (sem chave, nada sai da máquina):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODELO=qwen2.5:7b

# ---------- STT ----------
STT_MODELO=small          # tiny | base | small | medium | large-v3
STT_DEVICE=auto           # auto | cpu | cuda

# ---------- TTS ----------
TTS_MOTOR=piper           # piper (local) | edge (nuvem Microsoft)
# PIPER_VOZ=modelos/piper/pt_BR-faber-medium.onnx
# EDGE_VOZ=pt-BR-FranciscaNeural
